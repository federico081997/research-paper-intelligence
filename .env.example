# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

RPI_APP_NAME="Research Paper Intelligence"
RPI_ENVIRONMENT=development
RPI_LOG_LEVEL=INFO
RPI_DEVICE=auto


# -----------------------------------------------------------------------------
# Hugging Face repository
# -----------------------------------------------------------------------------

RPI_HF_REPOSITORY="Federico081997/research-paper-intelligence-data"

RPI_HF_RAW_PAPERS_FILE="raw_data/arxiv_papers.csv"
RPI_HF_PROCESSED_PAPERS_FILE="processed_data/arxiv_cleaned.csv"
RPI_HF_CLUSTER_SUMMARY_FILE="processed_data/cluster_summary.csv"
RPI_HF_PAPERS_CLUSTERED_FILE="processed_data/papers_clustered.csv"

RPI_HF_FAISS_INDEX_PAPERS_FILE="artifacts/faiss_paper_index.bin"
RPI_HF_TFIDF_VECTORIZER_FILE="artifacts/tfidf_vectorizer.joblib"
RPI_HF_TFIDF_MATRIX_FILE="artifacts/tfidf_matrix.npz"
RPI_HF_PAPER_EMBEDDINGS_FILE="artifacts/paper_embeddings.npy"


# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------

RPI_EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
RPI_EMBEDDING_BATCH_SIZE=32


# -----------------------------------------------------------------------------
# Hybrid ranking
# -----------------------------------------------------------------------------

RPI_CANDIDATE_TOP_K=100
RPI_HALF_LIFE_YEARS=5.0

RPI_SEMANTIC_WEIGHT=0.75
RPI_TFIDF_WEIGHT=0.10
RPI_KEYWORD_WEIGHT=0.10
RPI_RECENCY_WEIGHT=0.05


# -----------------------------------------------------------------------------
# FastAPI
# -----------------------------------------------------------------------------

RPI_API_HOST="127.0.0.1"
RPI_API_PORT=8000
RPI_API_RELOAD=true
RPI_API_TIMEOUT_SECONDS=10.0


# -----------------------------------------------------------------------------
# Streamlit
# -----------------------------------------------------------------------------

RPI_STREAMLIT_HOST="127.0.0.1"
RPI_STREAMLIT_PORT=8501
RPI_STREAMLIT_HEADLESS=true
RPI_STREAMLIT_RUN_ON_SAVE=true


# -----------------------------------------------------------------------------
# LangChain / Gemini
# -----------------------------------------------------------------------------

RPI_MODEL_PROVIDER="google_genai"
RPI_MODEL_NAME="gemini-3.6-flash"

RPI_RETRIEVAL_K=5
RPI_MAX_QUERY_REWRITES=1


# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------

GOOGLE_API_KEY="replace-with-your-google-ai-api-key"